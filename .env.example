# ─────────────────────────────────────────────────────────────────────────────
# Vela Server — environment configuration
# Copy to .env and fill in all values before starting.
# All values may also be passed as real environment variables; .env is only
# for local development convenience.
# ─────────────────────────────────────────────────────────────────────────────

# ── Network ──────────────────────────────────────────────────────────────────
# Address the gRPC server listens on.
VELA_GRPC_LISTEN=0.0.0.0:50051

# Address the HTTP/REST server (Drogon) listens on.
VELA_HTTP_LISTEN=0.0.0.0:8080

# Address the Prometheus metrics endpoint listens on. Leave blank to disable.
VELA_METRICS_LISTEN=0.0.0.0:9100

# ── Database ──────────────────────────────────────────────────────────────────
VELA_DB_HOST=localhost
VELA_DB_PORT=5432
VELA_DB_NAME=vela
VELA_DB_USER=vela
VELA_DB_PASSWORD=changeme
VELA_DB_POOL_SIZE=10
VELA_DB_CONNECT_TIMEOUT_SEC=10

# ── Concurrency ──────────────────────────────────────────────────────────────
# Number of gRPC completion-queue threads (0 = hardware_concurrency).
VELA_GRPC_THREADS=0

# Number of Drogon I/O threads (0 = hardware_concurrency).
VELA_HTTP_THREADS=0

# ── Logging ───────────────────────────────────────────────────────────────────
# debug | info | warn | error | critical
VELA_LOG_LEVEL=info

# ── Backpressure / Ingest ─────────────────────────────────────────────────────
# Maximum enqueued ResultEnvelopes per active stream before backpressure kicks in.
VELA_STREAM_QUEUE_SIZE=1024

# Maximum enqueued log entries before backpressure kicks in.
VELA_LOG_QUEUE_SIZE=4096

# ── Shutdown ──────────────────────────────────────────────────────────────────
# Seconds to wait for in-flight work to drain on SIGTERM/SIGINT.
VELA_SHUTDOWN_TIMEOUT_SEC=30

# ── Registry ──────────────────────────────────────────────────────────────────
# Path to protos/registry/modules.yaml. Relative paths are resolved from CWD.
VELA_REGISTRY_PATH=../protos/registry/modules.yaml

# ── Auth ─────────────────────────────────────────────────────────────────────
# Secret key used to sign session tokens (min 32 chars).
VELA_SESSION_SECRET=change-this-to-a-random-secret-at-least-32-chars

# Argon2id parameters (memory in KiB, iterations, parallelism).
VELA_ARGON2_MEM_KIB=65536
VELA_ARGON2_ITER=3
VELA_ARGON2_PARALLEL=4

# Max login attempts per IP per minute before rate-limiting.
VELA_LOGIN_RATE_LIMIT=10

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the Web UI.
VELA_CORS_ORIGINS=http://localhost:3000

# ── OTA ──────────────────────────────────────────────────────────────────────
# Directory where uploaded OTA artifacts are stored.
VELA_OTA_STORAGE_PATH=/var/lib/vela/ota

# Path to the OTA signing public key (PEM). Leave empty to skip signature check.
VELA_OTA_SIGNING_KEY_PATH=

# ── Email / SMTP ─────────────────────────────────────────────────────────────
VELA_SMTP_HOST=
VELA_SMTP_PORT=587
VELA_SMTP_USER=
VELA_SMTP_PASSWORD=
VELA_SMTP_FROM=vela@example.com
VELA_SMTP_TLS=true
